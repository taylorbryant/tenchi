{
  "components": {
    "schemas": {
      "Citation": {
        "properties": {
          "passage_id": {
            "title": "Passage Id",
            "type": "string"
          },
          "source_id": {
            "title": "Source Id",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "url": {
            "anyOf": [
              {
                "format": "uri",
                "maxLength": 2083,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Url"
          }
        },
        "required": [
          "passage_id",
          "source_id",
          "title"
        ],
        "title": "Citation",
        "type": "object"
      },
      "ErrorResponse": {
        "properties": {
          "code": {
            "type": "string"
          },
          "details": {},
          "message": {
            "type": "string"
          },
          "request_id": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "PassageMatch": {
        "properties": {
          "id": {
            "title": "Id",
            "type": "string"
          },
          "position": {
            "title": "Position",
            "type": "integer"
          },
          "score": {
            "maximum": 1,
            "minimum": 0,
            "title": "Score",
            "type": "number"
          },
          "source_id": {
            "title": "Source Id",
            "type": "string"
          },
          "text": {
            "title": "Text",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "url": {
            "anyOf": [
              {
                "format": "uri",
                "maxLength": 2083,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Url"
          }
        },
        "required": [
          "id",
          "source_id",
          "title",
          "text",
          "position",
          "score"
        ],
        "title": "PassageMatch",
        "type": "object"
      },
      "Source": {
        "properties": {
          "id": {
            "title": "Id",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/SourceStatus"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "url": {
            "anyOf": [
              {
                "format": "uri",
                "maxLength": 2083,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Url"
          }
        },
        "required": [
          "id",
          "title",
          "status"
        ],
        "title": "Source",
        "type": "object"
      },
      "SourceStatus": {
        "enum": [
          "pending",
          "indexed"
        ],
        "title": "SourceStatus",
        "type": "string"
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "A cited personal-research API built as Tenchi's AI reference backend.",
    "title": "Fieldnotes",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/answers": {
      "post": {
        "operationId": "answer_question",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "limit": {
                    "default": 5,
                    "maximum": 20,
                    "minimum": 1,
                    "title": "Limit",
                    "type": "integer"
                  },
                  "question": {
                    "maxLength": 2000,
                    "minLength": 1,
                    "title": "Question",
                    "type": "string"
                  }
                },
                "required": [
                  "question"
                ],
                "title": "AskQuestion",
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "citations": {
                      "items": {
                        "$ref": "#/components/schemas/Citation"
                      },
                      "title": "Citations",
                      "type": "array"
                    },
                    "has_citations": {
                      "title": "Has Citations",
                      "type": "boolean"
                    },
                    "text": {
                      "maxLength": 20000,
                      "minLength": 1,
                      "title": "Text",
                      "type": "string"
                    },
                    "tokens": {
                      "anyOf": [
                        {
                          "maximum": 9007199254740991,
                          "minimum": 0,
                          "type": "integer"
                        },
                        {
                          "type": "null"
                        }
                      ],
                      "default": null,
                      "title": "Tokens"
                    }
                  },
                  "required": [
                    "text",
                    "citations",
                    "has_citations"
                  ],
                  "title": "Answer",
                  "type": "object"
                }
              }
            },
            "description": "Successful response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "UNAUTHORIZED: Unauthorized"
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "REQUEST_TOO_LARGE: Request body too large"
          },
          "415": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "UNSUPPORTED_MEDIA_TYPE: Request media type does not match the contract"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "VALIDATION_ERROR: Request validation failed"
          },
          "502": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "ANSWER_GENERATION_FAILED: The answer provider returned an invalid result"
          },
          "504": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "ANSWER_GENERATION_TIMED_OUT: The answer provider did not respond before the deadline; REQUEST_TIMEOUT: Request deadline exceeded"
          }
        },
        "summary": "Answer from indexed evidence and return exact citations",
        "tags": [
          "knowledge"
        ],
        "x-timeout-seconds": 30
      }
    },
    "/search": {
      "post": {
        "operationId": "search_knowledge",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "limit": {
                    "default": 5,
                    "maximum": 20,
                    "minimum": 1,
                    "title": "Limit",
                    "type": "integer"
                  },
                  "query": {
                    "maxLength": 500,
                    "minLength": 1,
                    "title": "Query",
                    "type": "string"
                  }
                },
                "required": [
                  "query"
                ],
                "title": "SearchKnowledge",
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "matches": {
                      "items": {
                        "$ref": "#/components/schemas/PassageMatch"
                      },
                      "title": "Matches",
                      "type": "array"
                    }
                  },
                  "required": [
                    "matches"
                  ],
                  "title": "SearchResults",
                  "type": "object"
                }
              }
            },
            "description": "Successful response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "UNAUTHORIZED: Unauthorized"
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "REQUEST_TOO_LARGE: Request body too large"
          },
          "415": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "UNSUPPORTED_MEDIA_TYPE: Request media type does not match the contract"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "VALIDATION_ERROR: Request validation failed"
          }
        },
        "summary": "Search indexed passages owned by the authenticated user",
        "tags": [
          "knowledge"
        ]
      }
    },
    "/sources": {
      "get": {
        "operationId": "list_sources",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Source"
                  },
                  "type": "array"
                }
              }
            },
            "description": "Successful response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "UNAUTHORIZED: Unauthorized"
          }
        },
        "summary": "List sources owned by the authenticated user",
        "tags": [
          "sources"
        ]
      },
      "post": {
        "operationId": "save_source",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "content": {
                    "maxLength": 200000,
                    "minLength": 1,
                    "title": "Content",
                    "type": "string"
                  },
                  "title": {
                    "maxLength": 200,
                    "minLength": 1,
                    "title": "Title",
                    "type": "string"
                  },
                  "url": {
                    "anyOf": [
                      {
                        "format": "uri",
                        "maxLength": 2083,
                        "minLength": 1,
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null,
                    "title": "Url"
                  }
                },
                "required": [
                  "title",
                  "content"
                ],
                "title": "SaveSource",
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "id": {
                      "title": "Id",
                      "type": "string"
                    },
                    "status": {
                      "$ref": "#/components/schemas/SourceStatus"
                    },
                    "title": {
                      "title": "Title",
                      "type": "string"
                    },
                    "url": {
                      "anyOf": [
                        {
                          "format": "uri",
                          "maxLength": 2083,
                          "minLength": 1,
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ],
                      "default": null,
                      "title": "Url"
                    }
                  },
                  "required": [
                    "id",
                    "title",
                    "status"
                  ],
                  "title": "Source",
                  "type": "object"
                }
              }
            },
            "description": "Successful response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "UNAUTHORIZED: Unauthorized"
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "REQUEST_TOO_LARGE: Request body too large"
          },
          "415": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "UNSUPPORTED_MEDIA_TYPE: Request media type does not match the contract"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "VALIDATION_ERROR: Request validation failed"
          }
        },
        "summary": "Save text or URL-backed material for background indexing",
        "tags": [
          "sources"
        ]
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ]
}
