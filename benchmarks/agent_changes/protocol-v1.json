{
  "schema_version": 1,
  "schemas": {
    "list": {
      "$defs": {
        "ListedTaskPayload": {
          "additionalProperties": false,
          "properties": {
            "description": {
              "minLength": 1,
              "title": "Description",
              "type": "string"
            },
            "digest": {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "title": "Digest",
              "type": "string"
            },
            "id": {
              "minLength": 1,
              "title": "Id",
              "type": "string"
            },
            "title": {
              "minLength": 1,
              "title": "Title",
              "type": "string"
            }
          },
          "required": [
            "id",
            "digest",
            "title",
            "description"
          ],
          "title": "ListedTaskPayload",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "tasks": {
          "items": {
            "$ref": "#/$defs/ListedTaskPayload"
          },
          "title": "Tasks",
          "type": "array"
        }
      },
      "required": [
        "schema_version",
        "tasks"
      ],
      "title": "BenchmarkTaskListPayload",
      "type": "object"
    },
    "result": {
      "$defs": {
        "AgentInterface": {
          "enum": [
            "cli",
            "mcp",
            "mixed",
            "unknown"
          ],
          "type": "string"
        },
        "AgentResultPayload": {
          "additionalProperties": false,
          "properties": {
            "attempt": {
              "maximum": 10000,
              "minimum": 1,
              "title": "Attempt",
              "type": "integer"
            },
            "duration_seconds": {
              "maximum": 31536000,
              "minimum": 0,
              "title": "Duration Seconds",
              "type": "number"
            },
            "exit_code": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Exit Code"
            },
            "interface": {
              "$ref": "#/$defs/AgentInterface"
            },
            "interventions": {
              "maximum": 9007199254740991,
              "minimum": 0,
              "title": "Interventions",
              "type": "integer"
            },
            "label": {
              "minLength": 1,
              "title": "Label",
              "type": "string"
            },
            "status": {
              "$ref": "#/$defs/AgentStatus"
            },
            "token_count": {
              "maximum": 9007199254740991,
              "minimum": 0,
              "title": "Token Count",
              "type": "integer"
            }
          },
          "required": [
            "label",
            "interface",
            "attempt",
            "interventions",
            "status",
            "exit_code",
            "duration_seconds"
          ],
          "title": "AgentResultPayload",
          "type": "object"
        },
        "AgentStatus": {
          "enum": [
            "passed",
            "failed",
            "timed_out",
            "external"
          ],
          "type": "string"
        },
        "SourceResultPayload": {
          "additionalProperties": false,
          "properties": {
            "baseline_commit": {
              "minLength": 1,
              "title": "Baseline Commit",
              "type": "string"
            },
            "changed_file_count": {
              "maximum": 9007199254740991,
              "minimum": 0,
              "title": "Changed File Count",
              "type": "integer"
            },
            "changed_files": {
              "items": {
                "minLength": 1,
                "type": "string"
              },
              "maxItems": 200,
              "title": "Changed Files",
              "type": "array"
            },
            "head_commit": {
              "minLength": 1,
              "title": "Head Commit",
              "type": "string"
            }
          },
          "required": [
            "baseline_commit",
            "head_commit",
            "changed_file_count",
            "changed_files"
          ],
          "title": "SourceResultPayload",
          "type": "object"
        },
        "StepName": {
          "enum": [
            "task_integrity",
            "agent_tests",
            "hidden_acceptance",
            "tenchi_verify"
          ],
          "type": "string"
        },
        "StepResultPayload": {
          "additionalProperties": false,
          "properties": {
            "code": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Code"
            },
            "duration_seconds": {
              "maximum": 31536000,
              "minimum": 0,
              "title": "Duration Seconds",
              "type": "number"
            },
            "exit_code": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Exit Code"
            },
            "name": {
              "$ref": "#/$defs/StepName"
            },
            "status": {
              "$ref": "#/$defs/StepStatus"
            }
          },
          "required": [
            "name",
            "status",
            "exit_code",
            "duration_seconds",
            "code"
          ],
          "title": "StepResultPayload",
          "type": "object"
        },
        "StepStatus": {
          "enum": [
            "passed",
            "failed",
            "timed_out",
            "invalid"
          ],
          "type": "string"
        }
      },
      "additionalProperties": false,
      "properties": {
        "agent": {
          "$ref": "#/$defs/AgentResultPayload"
        },
        "first_pass": {
          "title": "First Pass",
          "type": "boolean"
        },
        "ok": {
          "title": "Ok",
          "type": "boolean"
        },
        "schema_version": {
          "const": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "source": {
          "$ref": "#/$defs/SourceResultPayload"
        },
        "steps": {
          "items": {
            "$ref": "#/$defs/StepResultPayload"
          },
          "maxItems": 4,
          "minItems": 4,
          "title": "Steps",
          "type": "array"
        },
        "task": {
          "minLength": 1,
          "title": "Task",
          "type": "string"
        },
        "task_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Task Digest",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "task",
        "task_digest",
        "ok",
        "first_pass",
        "agent",
        "source",
        "steps"
      ],
      "title": "BenchmarkResultPayload",
      "type": "object"
    },
    "state": {
      "additionalProperties": false,
      "properties": {
        "baseline_commit": {
          "minLength": 1,
          "title": "Baseline Commit",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "task": {
          "minLength": 1,
          "title": "Task",
          "type": "string"
        },
        "task_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Task Digest",
          "type": "string"
        },
        "workspace": {
          "minLength": 1,
          "title": "Workspace",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "task",
        "task_digest",
        "workspace",
        "baseline_commit"
      ],
      "title": "BenchmarkStatePayload",
      "type": "object"
    },
    "summary": {
      "$defs": {
        "TaskSummaryPayload": {
          "additionalProperties": false,
          "properties": {
            "first_pass_rate": {
              "maximum": 1,
              "minimum": 0,
              "title": "First Pass Rate",
              "type": "number"
            },
            "first_passed": {
              "maximum": 9007199254740991,
              "minimum": 0,
              "title": "First Passed",
              "type": "integer"
            },
            "pass_rate": {
              "maximum": 1,
              "minimum": 0,
              "title": "Pass Rate",
              "type": "number"
            },
            "passed": {
              "maximum": 9007199254740991,
              "minimum": 0,
              "title": "Passed",
              "type": "integer"
            },
            "runs": {
              "maximum": 9007199254740991,
              "minimum": 0,
              "title": "Runs",
              "type": "integer"
            },
            "task": {
              "minLength": 1,
              "title": "Task",
              "type": "string"
            },
            "task_digest": {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "title": "Task Digest",
              "type": "string"
            }
          },
          "required": [
            "task",
            "task_digest",
            "runs",
            "passed",
            "first_passed",
            "pass_rate",
            "first_pass_rate"
          ],
          "title": "TaskSummaryPayload",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "properties": {
        "first_pass_rate": {
          "maximum": 1,
          "minimum": 0,
          "title": "First Pass Rate",
          "type": "number"
        },
        "first_passed": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "First Passed",
          "type": "integer"
        },
        "pass_rate": {
          "maximum": 1,
          "minimum": 0,
          "title": "Pass Rate",
          "type": "number"
        },
        "passed": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Passed",
          "type": "integer"
        },
        "runs": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Runs",
          "type": "integer"
        },
        "schema_version": {
          "const": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "tasks": {
          "items": {
            "$ref": "#/$defs/TaskSummaryPayload"
          },
          "title": "Tasks",
          "type": "array"
        }
      },
      "required": [
        "schema_version",
        "runs",
        "passed",
        "first_passed",
        "pass_rate",
        "first_pass_rate",
        "tasks"
      ],
      "title": "BenchmarkSummaryPayload",
      "type": "object"
    }
  }
}
