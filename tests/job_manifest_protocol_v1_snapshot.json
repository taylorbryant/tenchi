          "description",
          "input_schema"
        ],
        "title": "JobManifestEntry",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "description": "Versioned deterministic discovery document for registered jobs.",
    "properties": {
      "jobs": {
        "items": {
          "$ref": "#/$defs/JobManifestEntry"
        },
        "title": "Jobs",
        "type": "array"
