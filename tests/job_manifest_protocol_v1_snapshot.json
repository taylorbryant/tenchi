{
  "manifest_schema": {
    "$defs": {
      "JobManifestEntry": {
        "additionalProperties": false,
        "description": "One durable job message contract in a discovery manifest.",
        "properties": {
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "input_schema": {
            "additionalProperties": true,
            "title": "Input Schema",
            "type": "object"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
