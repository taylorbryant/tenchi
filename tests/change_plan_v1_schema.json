    },
    "plan_id": {
      "$ref": "#/$defs/ChangePlanId"
    },
    "required_postconditions": {
      "$ref": "#/$defs/ChangePlanPostconditions"
    },
    "schema_version": {
      "$ref": "#/$defs/ChangePlanSchemaVersion"
    },
