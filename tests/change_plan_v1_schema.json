          "const": "generated_files_exist"
        },
        {
          "const": "incomplete_markers_removed"
        },
        {
          "const": "contract_registered"
        },
        {
          "const": "use_case_registered"
        },
        {
          "const": "route_binds_contract"
        },
        {
          "const": "route_binds_use_case"
        },
        {
          "const": "test_imports_use_case"
        }
      ],
      "type": "array"
    },
    "ChangePlanSchemaVersion": {
      "const": 1,
      "type": "integer"
    },
    "ChangePlanUseCasePayload": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "signature": {
          "title": "Signature",
          "type": "string"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "test": {
          "title": "Test",
          "type": "string"
        }
      },
      "required": [
        "name",
        "signature",
        "source",
        "test"
