      "type": "string"
    },
    "ChangePlanContractPayload": {
      "additionalProperties": false,
      "properties": {
        "method": {
          "title": "Method",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "target": {
          "title": "Target",
          "type": "string"
        }
      },
      "required": [
        "target",
        "name",
        "method",
        "path"
      ],
      "title": "ChangePlanContractPayload",
      "type": "object"
    },
    "ChangePlanId": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
